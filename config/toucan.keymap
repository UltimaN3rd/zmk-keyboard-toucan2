#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NUMNAV 1
#define FNMEDIA 2
#define MOUSE 3

&mt {
    quick-tap-ms = <200>;
    tapping-term-ms = <200>;
    flavor = "balanced";
};

/ {
    behaviors {
        capsword_capslock: capsword_capslock {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            tapping-term-ms = <200>;
            flavor = "tap-preferred";

            bindings = <&kp &caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "QWERT";
            bindings = <
                &none &kp Q &kp W &kp E &kp R &kp T                  &kp Y     &kp U &kp I  &kp O  &kp P &none
                &none &kp A &kp S &kp D &kp F &kp G                  &kp H     &kp J &kp K  &kp L  &kp SEMI &none
                &none &kp Z &kp X &kp C &kp V &kp SINGLE_QUOTE       &kp COMMA &kp B &kp N  &kp M  &kp DOT &none
            &mt LGUI RETURN  &mt LCTRL SPACE  &mo 1                  &mo 2  &mt LSHFT BSPC  &mt LALT DEL
            >;
        };

        numnav {
            display-name = "Num-Nav";
            bindings = <
                &none &kp GRAVE &kp N7 &kp N8 &kp N9 &kp MINUS        &kp PG_UP &kp HOME &kp TAB  &kp END   &kp ESCAPE &none
                &none &kp SLASH &kp N4 &kp N5 &kp N6 &kp EQUAL        &kp PG_DN &kp LEFT &kp UP   &kp RIGHT &capsword_capslock CAPS 0 &none
                &none &kp N0    &kp N1 &kp N2 &kp N3 &trans           &kp BSLH  &kp LBKT &kp DOWN &kp RBKT  &kp PRINTSCREEN &none
                     &mt LALT RETURN &mt LSHFT SPACE &none            &none &mt LCTRL BSPC &mt LGUI DEL
            >;
        };

        fnmedia {
            display-name = "Fn-Media";
            bindings = <
                &none &kp F12 &kp F7 &kp F8 &kp F9 &trans          &kp C_VOL_UP &kp C_PREV   &kp C_PLAY_PAUSE &kp C_NEXT &trans &none
                &none &kp F11 &kp F4 &kp F5 &kp F6 &trans          &kp C_VOL_DN &kp C_BRI_UP &trans           &trans     &trans &none
                &none &kp F10 &kp F1 &kp F2 &kp F3 &trans          &kp C_MUTE   &kp C_BRI_DN &trans           &trans     &trans &none
                     &mt LALT RETURN &mt LSHFT SPACE &none         &none &mt LCTRL BSPC &mt LGUI DEL
            >;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
                &none &trans &trans &trans &trans &trans           &bt BT_PRV &trans &trans &trans &trans &none
                &none &trans &trans &trans &trans &trans           &bt BT_NXT &trans &trans &trans &trans &none
                &none &trans &trans &trans &trans &trans           &bt BT_CLR &trans &trans &trans &trans &none
                     &mkp RCLK &mkp LCLK &mkp MCLK           &mkp MB4 &mkp MB5 &studio_unlock
            >;
        };

        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};